  "myAccountTermsSectionIntroductionTitle": "Introduction",
  "@myAccountTermsSectionIntroductionTitle": {
    "description": "Section title for the introduction"
  },
  "myAccountTermsSectionIntroductionContent": "Welcome to Akarat (the “Platform”). These Terms & Conditions (“Terms”) serve as a legally binding agreement between Akarat and any individual or entity who accesses, uses, or interacts with our website, mobile application, digital solutions, or any related tools and functionalities (collectively, the “Services”). These Terms apply to all categories of users, including visitors, registered members, advertisers, licensed agents, developers, and any other parties accessing or utilizing the Platform.\n\nBy using or accessing any component of the Platform, you acknowledge that you have read, understood, and agreed to comply with these Terms, together with our Privacy Policy. If you disagree with any provision contained herein, you must immediately discontinue use of the Platform and all associated Services.",
  "@myAccountTermsSectionIntroductionContent": {
    "description": "Full introduction text in Terms & Conditions"
  },

  "myAccountTermsSectionWhoWeAreTitle": "1. Who We Are",
  "@myAccountTermsSectionWhoWeAreTitle": {
    "description": "Title of the 'Who We Are' section including numbering"
  },
  "myAccountTermsWhoWeAreCompany": "The Platform is owned and operated by EMLAK BULUCU PORTAL LLC, a legally registered entity in the United Arab Emirates (UAE).",
  "@myAccountTermsWhoWeAreCompany": {
    "description": "Company name and country of registration"
  },
  "myAccountTermsWhoWeAreOffice": "Registered Office: Westburry Office Tower, Floor 23, Office No. 2303, Business Bay, Dubai, UAE\nEmail: info@akarat.com",
  "@myAccountTermsWhoWeAreOffice": {
    "description": "Registered office address and email"
  },
  "myAccountTermsWhoWeArePronouns": "References to “we,” “us,” or “our” refer to Akarat as the Platform operator.",
  "@myAccountTermsWhoWeArePronouns": {
    "description": "Explanation of who 'we' refers to"
  },

  "myAccountTermsSectionDefinitionsTitle": "2. Definitions",
  "@myAccountTermsSectionDefinitionsTitle": {
    "description": "Title of the Definitions section including numbering"
  },

  "myAccountTermsDefinitionAdvertiser": "Advertiser: Any individual, business, or organization that posts property listings on the Platform to promote, market, or sell properties.",
  "@myAccountTermsDefinitionAdvertiser": { "description": "Definition of Advertiser" },
  "myAccountTermsDefinitionAgent": "Agent: A licensed real estate professional, broker, or agency authorized to list or market properties.",
  "@myAccountTermsDefinitionAgent": { "description": "Definition of Agent" },
  "myAccountTermsDefinitionContent": "Content: All materials uploaded or submitted to the Platform, including text, images, videos, documents, graphics, and other media.",
  "@myAccountTermsDefinitionContent": { "description": "Definition of Content" },
  "myAccountTermsDefinitionListing": "Listing: Any property advertisement, promotional entry, or post published on the Platform, including all related details and media.",
  "@myAccountTermsDefinitionListing": { "description": "Definition of Listing" },
  "myAccountTermsDefinitionUser": "User / You: Any person, company, or entity who accesses, navigates, or interacts with the Platform or its Services.",
  "@myAccountTermsDefinitionUser": { "description": "Definition of User / You" },
  "myAccountTermsDefinitionServices": "Services: The complete range of features, tools, functionalities, and solutions offered by Akarat through the Platform.",
  "@myAccountTermsDefinitionServices": { "description": "Definition of Services" },

  "myAccountTermsSectionAcceptanceTitle": "3. Acceptance of Terms",
  "@myAccountTermsSectionAcceptanceTitle": {
    "description": "Title of Acceptance of Terms section"
  },
  "myAccountTermsAcceptanceMain": "By accessing or using the Platform, you expressly acknowledge that you have read, understood, and agreed to be bound by these Terms. Your use of the Platform signifies your acceptance of all obligations outlined herein.",
  "@myAccountTermsAcceptanceMain": { "description": "Main acceptance paragraph" },
  "myAccountTermsAcceptanceNotAllowed": "You may not use the Platform if any of the following apply:",
  "@myAccountTermsAcceptanceNotAllowed": { "description": "Intro to list of prohibited users" },
  "myAccountTermsAcceptanceConditions": "• You are under the age of 18 years.\n• Your jurisdiction prohibits access to digital property marketplaces.\n• You do not meet the eligibility or legal requirements to list, advertise, or interact with property listings.",
  "@myAccountTermsAcceptanceConditions": { "description": "List of cases when platform cannot be used" },
  "myAccountTermsAcceptanceUpdates": "Akarat reserves the right to modify, amend, or update these Terms at any time without prior notice. Updates become effective immediately upon publication. Continued use of the Platform after such changes constitutes acceptance of the revised Terms.",
  "@myAccountTermsAcceptanceUpdates": { "description": "Text about terms updates" },

  "myAccountTermsSectionScopeTitle": "4. Scope of Use",
  "@myAccountTermsSectionScopeTitle": { "description": "Title of Scope of Use section" },
  "myAccountTermsScopeIntro": "Users must utilize the Platform professionally, ethically, and in accordance with all applicable laws. You are strictly prohibited from:",
  "@myAccountTermsScopeIntro": { "description": "Introduction to prohibited actions" },
  "myAccountTermsScopeProhibited": "• Uploading unlawful, misleading, fraudulent, or copyrighted material without permission.\n• Scraping, mining, copying, or extracting Platform data for commercial use.\n• Posting inaccurate, duplicate, or non-existent property listings.\n• Using automated tools, bots, or scripts to access or interact with the Platform.\n• Attempting to harm, disable, overburden, or interfere with Platform security or operations.",
  "@myAccountTermsScopeProhibited": { "description": "List of prohibited activities" },
  "myAccountTermsScopeConsequence": "Misuse may result in immediate suspension, account termination, content removal, or legal action.",
  "@myAccountTermsScopeConsequence": { "description": "Consequence of misuse" },

  "myAccountTermsSectionRegistrationTitle": "5. Account Registration",
  "@myAccountTermsSectionRegistrationTitle": { "description": "Title of Account Registration section" },
  "myAccountTermsRegistrationIntro": "Certain Services require user registration. You must provide accurate, complete, and up-to-date information. Users are responsible for:",
  "@myAccountTermsRegistrationIntro": { "description": "Introduction to account responsibilities" },
  "myAccountTermsRegistrationDuties": "• Protecting login credentials\n• Preventing unauthorized access\n• All activity performed under their account",
  "@myAccountTermsRegistrationDuties": { "description": "List of user responsibilities" },
  "myAccountTermsRegistrationNoLiability": "Akarat is not liable for losses resulting from negligence or unauthorized access.",
  "@myAccountTermsRegistrationNoLiability": { "description": "Disclaimer about account security" },

  "myAccountTermsSectionAdvertiserAgentTitle": "6. Advertiser & Agent Obligations",
  "@myAccountTermsSectionAdvertiserAgentTitle": { "description": "Title of Advertiser & Agent Obligations section" },
  "myAccountTermsAdvertiserAgentCompliance": "Advertisers and Agents must comply with all relevant UAE real estate regulations, including licensing and advertising requirements set by authorities such as the DLD (Dubai Land Department).",
  "@myAccountTermsAdvertiserAgentCompliance": { "description": "Compliance requirement for advertisers and agents" },
  "myAccountTermsListingMust": "All property listings must:",
  "@myAccountTermsListingMust": { "description": "Introduction to listing requirements" },
  "myAccountTermsListingRequirements": "• Be accurate, truthful, and currently available.\n• Contain updated information, images, specifications, and pricing.\n• Be backed by valid authorization, ownership documents, or listing agreements.",
  "@myAccountTermsListingRequirements": { "description": "Requirements for property listings" },
  "myAccountTermsAkaratRights": "Akarat reserves full rights to:",
  "@myAccountTermsAkaratRights": { "description": "Introduction to Akarat's rights over listings" },
  "myAccountTermsAkaratRightsList": "• Review and approve listings before publication.\n• Edit or remove content that violates guidelines.\n• Suspend accounts engaged in dishonest or unethical practices.",
  "@myAccountTermsAkaratRightsList": { "description": "List of Akarat's rights regarding listings" },
  "myAccountTermsAgentLicense": "Agents must hold a valid DLD license or equivalent certification depending on the emirate.",
  "@myAccountTermsAgentLicense": { "description": "License requirement for agents" },

  "myAccountTermsSectionUGCTitle": "7. User-Generated Content",
