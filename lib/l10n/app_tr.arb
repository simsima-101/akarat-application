  "myAccountPrivacyAgencyInfoList": "• Agency Name and Emirate\n• National ID and property location\n• Registered license number of Agency\n• Registered logo of Agency\n• Registered company license document\n• Registered office registration number",
  "@myAccountPrivacyAgencyInfoList": {
    "description": "List of agency registration fields"
  },
  "myAccountPrivacyAgencyPurpose": "We collect Agency data to verify the legitimacy of the business and ensure compliance with licensing requirements. This information allows us to create and display a verified Agency profile on Akarat.com, facilitate transparent communication between users and registered Agencies, and efficiently manage property listings and the agents associated with each Agency.",
  "@myAccountPrivacyAgencyPurpose": {
    "description": "Purpose of collecting agency data"
  },
  "myAccountPrivacyAgencyPublicDisplayTitle": "Akarat may publicly display:",
  "@myAccountPrivacyAgencyPublicDisplayTitle": {
    "description": "Subheading for public display items"
  },
  "myAccountPrivacyAgencyPublicDisplayList": "• Agency name, logo, ORN, and contact information\n• Office address and linked Agents\n• Publicly listed properties (views, listings)\n\nSensitive registration or licensing documents remain strictly confidential.",
  "@myAccountPrivacyAgencyPublicDisplayList": {
    "description": "What is shown publicly for agencies"
  },

  "myAccountPrivacyAgentInfoTitle": "→ Agent Information",
  "@myAccountPrivacyAgentInfoTitle": {
    "description": "Subsection title: Agent Information"
  },
  "myAccountPrivacyAgentInfoList": "• Agent name and Emirate\n• Registered Agent License Number\n• Agent National ID\n• Agent profile photo\n• Mobile phone number and WhatsApp number\n• Nationality",
  "@myAccountPrivacyAgentInfoList": {
    "description": "List of agent registration fields"
  },
  "myAccountPrivacyAgentPurpose": "We collect Agent data to verify their professional identity and authorization under RERA/DLD guidelines, to display verified Agent profiles on Akarat.com, and to facilitate communication between Agents and potential clients. Only limited information is displayed publicly, such as the Agent’s name, profile photo, linked Agency name and logo, and active property listings.\n\nSensitive documents, including copies of Emirates IDs, are never shared publicly.",
  "@myAccountPrivacyAgentPurpose": {
    "description": "Purpose and public display rules for agents"
  },

  "myAccountPrivacyPropertyInfoTitle": "→ Property Creation Information",
  "@myAccountPrivacyPropertyInfoTitle": {
    "description": "Subsection title: Property Creation Information"
  },
  "myAccountPrivacyPropertyPurpose": "When you list or manage a property on Akarat.com, we collect specific details to ensure your listing is complete, accurate, and compliant.",
  "@myAccountPrivacyPropertyPurpose": {
    "description": "Intro to property listing data collection"
  },
  "myAccountPrivacyPropertyCollectedTitle": "Information Collected:",
  "@myAccountPrivacyPropertyCollectedTitle": {
    "description": "Subheading for property data list"
  },
  "myAccountPrivacyPropertyCollectedList": "• Emirate and Trakheesi license details\n• Property Title and Description\n• Property type (e.g., apartment, villa, office, land)\n• Location and map coordinates\n• Payment details and rental period\n• Area size, number of bedrooms and bathrooms\n• Amenities and furnishing details\n• Availability status of property\n• All project-related details\n• Uploaded media (Photos, Floor Plans, YouTube Link)",
  "@myAccountPrivacyPropertyCollectedList": {
    "description": "List of property listing fields collected"
  },
  "myAccountPrivacyTrakheesiNote": "A Trakheesi license is a mandatory permit issued by the Dubai Land Department (DLD) through RERA, regulating all real estate advertising in Dubai. It ensures that property advertisements are legitimate, traceable, and compliant.\n\nWe collect property listing information to publish and display your listings to potential buyers or tenants, verify authenticity, improve search accuracy, and ensure advertising compliance in the UAE.",
  "@myAccountPrivacyTrakheesiNote": {
    "description": "Explanation of Trakheesi and purpose of property data"
  },

  "myAccountPrivacyChatDataTitle": "→ Chat Data",
  "@myAccountPrivacyChatDataTitle": {
    "description": "Subsection title: Chat Data"
  },
  "myAccountPrivacyChatDataContent": "Chat Data refers to the messages you exchange through the Platform. This includes any text sent or received. We use this data to facilitate communication between users and Agents, respond to inquiries, provide support, maintain a record of interactions, and improve our services.\n\nChat Data is confidential and securely stored in accordance with this Privacy Policy.",
  "@myAccountPrivacyChatDataContent": {
    "description": "Explanation and usage of chat data"
  },

  "myAccountPrivacyTechnicalDataTitle": "→ Technical Data",
  "@myAccountPrivacyTechnicalDataTitle": {
    "description": "Subsection title: Technical Data"
  },
  "myAccountPrivacyTechnicalDataList": "• IP Address\n• Login Data\n• Browser type and version\n• Operating system and platform\n• Device information\n• Time zone settings",
  "@myAccountPrivacyTechnicalDataList": {
    "description": "List of technical / device data points"
  },
  "myAccountPrivacyTechnicalPurpose": "We collect technical data to understand how users interact with our Platform, diagnose issues, improve performance and functionality, enhance security, and optimize user experience. This data may also be used for analytics, fraud detection, and regulatory compliance.",
  "@myAccountPrivacyTechnicalPurpose": {
    "description": "Purpose of collecting technical data"
  },

  "myAccountPrivacyMarketingDataTitle": "→ Marketing Data",
  "@myAccountPrivacyMarketingDataTitle": {
    "description": "Subsection title: Marketing Data"
  },
  "myAccountPrivacyMarketingContent": "We may collect information about your marketing preferences, including whether you wish to receive new property alerts, account status updates, enquiry notifications, or promotional messages. This helps us send relevant and useful content while ensuring you only receive communications in your preferred manner.\n\nYou may update or withdraw your marketing preferences at any time through your account settings or by contacting us.",
  "@myAccountPrivacyMarketingContent": {
    "description": "Explanation of marketing preferences collection"
  },

  "myAccountPrivacyRefusalTitle": "What happens if you refuse to provide necessary Personal Data?",
  "@myAccountPrivacyRefusalTitle": {
    "description": "Heading: What if user refuses to provide data"
  },
  "myAccountPrivacyRefusalContent": "You are not required to provide Personal Data to us. However, if certain data is necessary to access the Platform or comply with legal requirements, and you do not provide it, we may be unable to grant access. For example, we require your email address to register your account on Akarat.com.",
  "@myAccountPrivacyRefusalContent": {
    "description": "Consequence of not providing required data"
  },

  "myAccountPrivacySectionLegalTitle": "Legal Basis for Processing",
  "@myAccountPrivacySectionLegalTitle": {
    "description": "Main heading: Legal Basis for Processing"
  },
  "myAccountPrivacyLegalIntro": "Under applicable privacy laws, we must ensure that each purpose for which we use your Personal Data is supported by a valid legal basis. In most cases, we rely on one of the following:",
  "@myAccountPrivacyLegalIntro": {
    "description": "Introduction to legal bases"
  },
  "myAccountPrivacyLegalBases": "• Contractual Necessity – When processing your Personal Data is required to fulfil our contract with you (for example, enabling your access to the Platform).\n\n• Compliance with Law – When we must process your Personal Data to meet legal or regulatory requirements.\n\n• Consent – When you have provided clear permission for us to process your Personal Data for a specific purpose.",
  "@myAccountPrivacyLegalBases": {
    "description": "List of legal bases for processing"
  },

  "myAccountPrivacySectionShareTitle": "Who Do We Share Your Information With?",
  "@myAccountPrivacySectionShareTitle": {
    "description": "Main heading: Sharing information"
  },
  "myAccountPrivacyShareContent": "We require all parties who receive your Personal Data to apply appropriate security measures to protect it, in line with our policies and applicable data protection obligations. We do not allow any third-party service providers who process Personal Data on our behalf to use it for their own purposes. They are only permitted to handle your Personal Data for the specific purposes we define and strictly in accordance with our instructions.\n\nWe may also need to share certain Personal Data with other users of the Platform when you choose to engage in transactions with them. For example, if you express interest in a property listed by an Agent, relevant representatives of that Agent may require access to your Personal Data.",
  "@myAccountPrivacyShareContent": {
    "description": "Full text explaining data sharing practices"
  },

  "myAccountPrivacySectionSecurityTitle": "How We Keep Your Data Secure",
  "@myAccountPrivacySectionSecurityTitle": {
    "description": "Main heading: Data security"
  },
  "myAccountPrivacySecurityContent": "We have implemented suitable security measures to protect your Personal Data from accidental loss, alteration, unauthorized access, or misuse.\n\nAccess to your Personal Data is restricted to employees and authorized personnel who require it for legitimate business purposes. All individuals with such access are bound by confidentiality obligations.\n\nWe also maintain robust procedures to detect, manage, and respond to any actual or suspected Personal Data breaches. In such cases, we take immediate steps to minimize potential impact on your privacy and cooperate with relevant regulatory authorities as required.",
  "@myAccountPrivacySecurityContent": {
    "description": "Full text about security measures"
  },

  "myAccountPrivacySectionRightsTitle": "Your Rights",
  "@myAccountPrivacySectionRightsTitle": {
    "description": "Main heading: User rights"
  },
  "myAccountPrivacyRightsIntro": "Depending on the applicable data protection laws and where your Personal Data is under our control, you may have the right to:",
  "@myAccountPrivacyRightsIntro": {
    "description": "Intro to list of rights"
  },
  "myAccountPrivacyRightsList": "• Access — Request a copy of the Personal Data we hold about you.\n• Correction — Ask us to update or amend inaccurate or incomplete information.\n• Erasure — Request deletion of your Personal Data where it is no longer needed for its original purpose.\n• Restrict Processing — Ask us to temporarily or permanently stop processing all or part of your data.\n• Objection — Object to processing based on our legitimate interests or for direct marketing.\n• Data Portability — Request a structured, machine-readable copy of your Personal Data.\n• Withdrawal of Consent — Withdraw consent where processing is based on your permission.\n\nIf you want to exercise any of these rights, please contact us.",
  "@myAccountPrivacyRightsList": {
    "description": "List of user data protection rights"
  },

  "myAccountPrivacySectionMarketingTitle": "Marketing Communications",
  "@myAccountPrivacySectionMarketingTitle": {
    "description": "Main heading: Marketing communications"
  },
  "myAccountPrivacyMarketingContent": "We may collect and store your preferences regarding the marketing communications you wish to receive from us, including property alerts, account updates, enquiry responses, and promotional messages. This helps us tailor communication to your interests.\n\nYou may opt out at any time by clicking the “Unsubscribe” link in any marketing email or by contacting us at info@akarat.com. Opting out will not affect your ability to use the Platform.",
  "@myAccountPrivacyMarketingContent": {
    "description": "Full text about marketing preferences and opt-out"
  },

  "myAccountPrivacySectionMinorsTitle": "Our Privacy for Minors",
  "@myAccountPrivacySectionMinorsTitle": {
    "description": "Main heading: Minors protection"
  },
  "myAccountPrivacyMinorsContent": "This Platform is not intended for use by anyone under 18. We do not knowingly collect data from minors or verify user age. If you believe a minor is using the Platform, please notify us at info@akarat.com so we can remove any associated Personal Data and prevent further access.",
  "@myAccountPrivacyMinorsContent": {
    "description": "Text about protection of minors"
  },

  "myAccountPrivacySectionThirdPartyTitle": "Third-Party Links",
  "@myAccountPrivacySectionThirdPartyTitle": {
    "description": "Main heading: Third-party links"
  },
  "myAccountPrivacyThirdPartyContent": "The Platform may contain links to third-party websites or services. Akarat is not responsible for the content, availability, or privacy practices of external sites. When you leave our Platform, we encourage you to review the privacy policies of each website you visit.",
  "@myAccountPrivacyThirdPartyContent": {
    "description": "Text about third-party links disclaimer"
  },

  "myAccountPrivacySectionUpdatesTitle": "Changes to the Privacy Policy",
  "@myAccountPrivacySectionUpdatesTitle": {
    "description": "Main heading: Policy updates"
  },
  "myAccountPrivacyUpdatesContent": "We may update this Privacy Policy at any time, with or without prior notice. When updates occur, we will revise this page and may notify you directly in certain cases (for example, by email). All changes become effective immediately once posted.",
  "@myAccountPrivacyUpdatesContent": {
    "description": "Text about policy change procedure"
  },

